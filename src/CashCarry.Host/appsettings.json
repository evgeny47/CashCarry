{
  "Robot": {
    "Mode": "Paper",
    // Раз в 15 с: на 7 пар это ≈ 21 запрос котировок за тик — с запасом до лимита запросов Финам
    "PollInterval": "00:00:15",
    "StatusLogInterval": "00:05:00",
    "DatabasePath": "data/cashcarry.db",
    "IgnoreTradingSchedule": false,
    // Лимит денег робота, ₽, по всем парам: акции по цене входа + ГО + резерв под ВМ.
    // Ограничивает только новые входы, открытые позиции не сокращает. null — без лимита.
    "MaxCapital": 50000,
    // Праздники MOEX — сверьте с календарём биржи
    "Holidays": [ "2026-11-04", "2027-01-01", "2027-01-02", "2027-01-07" ]
  },

  // Пары «акция + фьючерс на неё». Деньги счёта общие: если входить хотят несколько пар,
  // первой входит самая доходная. Символы в формате Финам ticker@mic.
  // Поиск кодов: dotnet run --project src/CashCarry.Host -- --find-symbols SR
  // Проверка лота, размера контракта, ГО и экспираций всех пар: ... -- --finam-check
  // LastTradingDay — последний день торгов серии; InitialMargin — ГО на контракт, руб. (обновляйте по данным биржи).
  // Enabled: false — новых входов нет, открытую позицию робот доведёт до закрытия.
  // Strategy внутри пары переопределяет только указанные поля общей секции Strategy.
  "Pairs": [
    {
      "Name": "SBER",
      "Enabled": false, // выключена 15.10.2026: под 50 тыс. ₽ выбраны 3 GAZP + 1 VTBR
      // Сверено с Финам 13.10.2026 (--finam-check): лот SBER = 1 акция, контракт SR = 100 акций.
      "StockSymbol": "SBER@MISX",
      "StockLotSize": 1,
      "StockPriceStep": 0.01,
      "SharesPerContract": 100,
      "PointValue": 1,
      "FuturesPriceStep": 1,
      "Futures": [
        { "Symbol": "SRZ6@RTSX", "LastTradingDay": "2026-12-17", "InitialMargin": 5300 },
        { "Symbol": "SRH7@RTSX", "LastTradingDay": "2027-03-18", "InitialMargin": 6240 },
        { "Symbol": "SRM7@RTSX", "LastTradingDay": "2027-06-17", "InitialMargin": 6750 }
      ],
      // Объявленные дивиденды: последний день покупки с правом на дивиденд и сумма на акцию до налога
      "Dividends": [],
      "Strategy": { "MaxUnits": 3 }
    },
    {
      "Name": "GAZP",
      // Включена 13.10.2026 для бумажной проверки. Сверено с Финам 13.10.2026: лот GAZP = 10 акций, контракт GZ = 100 акций.
      "Enabled": true, // включена 15.10.2026: 3 единицы под лимит 50 тыс. ₽
      "StockSymbol": "GAZP@MISX",
      "StockLotSize": 10,
      "StockPriceStep": 0.01,
      "SharesPerContract": 100,
      "PointValue": 1,
      "FuturesPriceStep": 1,
      "Futures": [
        { "Symbol": "GZZ6@RTSX", "LastTradingDay": "2026-12-17", "InitialMargin": 1935 },
        { "Symbol": "GZH7@RTSX", "LastTradingDay": "2027-03-18", "InitialMargin": 2275 },
        { "Symbol": "GZM7@RTSX", "LastTradingDay": "2027-06-17", "InitialMargin": 2455 }
      ],
      "Dividends": [],
      "Strategy": { "MaxUnits": 3 }
    },
    {
      "Name": "LKOH",
      // Сверено с Финам 13.10.2026: лот LKOH = 1 акция, шаг 0.5; контракт LK = 10 акций (не 100!).
      "Enabled": false, // выключена 14.10.2026
      "StockSymbol": "LKOH@MISX",
      "StockLotSize": 1,
      "StockPriceStep": 0.5,
      "SharesPerContract": 10,
      "PointValue": 1,
      "FuturesPriceStep": 1,
      "Futures": [
        { "Symbol": "LKZ6@RTSX", "LastTradingDay": "2026-12-17", "InitialMargin": 10935 },
        { "Symbol": "LKH7@RTSX", "LastTradingDay": "2027-03-18", "InitialMargin": 13260 },
        { "Symbol": "LKM7@RTSX", "LastTradingDay": "2027-06-17", "InitialMargin": 13025 }
      ],
      // Рекомендация СД: 535 ₽, реестр 09.12.2026 (последний день покупки 08.12). Проверьте решение собрания акционеров.
      "Dividends": [ { "LastBuyDate": "2026-12-08", "AmountPerShare": 535 } ],
      "Strategy": { "MaxUnits": 3 }
    },
    {
      "Name": "GMKN",
      // Сверено с Финам 13.10.2026: лот GMKN = 10 акций, шаг 0.02; контракт GK = 10 акций (1 лот на контракт).
      "Enabled": false, // выключена 13.10.2026
      "StockSymbol": "GMKN@MISX",
      "StockLotSize": 10,
      "StockPriceStep": 0.02,
      "SharesPerContract": 10,
      "PointValue": 1,
      "FuturesPriceStep": 1,
      "Futures": [
        { "Symbol": "GKZ6@RTSX", "LastTradingDay": "2026-12-17", "InitialMargin": 232 },
        { "Symbol": "GKH7@RTSX", "LastTradingDay": "2027-03-18", "InitialMargin": 271 }
      ],
      "Dividends": [],
      "Strategy": { "MaxUnits": 3 }
    },
    {
      "Name": "VTBR",
      // Сверено с Финам 13.10.2026: лот VTBR = 1 акция, шаг 0.005; контракт VB = 100 акций.
      "Enabled": true, // включена 15.10.2026: 1 единица на остаток лимита
      "StockSymbol": "VTBR@MISX",
      "StockLotSize": 1,
      "StockPriceStep": 0.005,
      "SharesPerContract": 100,
      "PointValue": 1,
      "FuturesPriceStep": 1,
      "Futures": [
        { "Symbol": "VBZ6@RTSX", "LastTradingDay": "2026-12-17", "InitialMargin": 1041 },
        { "Symbol": "VBH7@RTSX", "LastTradingDay": "2027-03-18", "InitialMargin": 1223 }
      ],
      "Dividends": [],
      "Strategy": { "MaxUnits": 1 }
    },
    {
      "Name": "ROSN",
      // Сверено с Финам 13.10.2026: лот ROSN = 1 акция, шаг 0.05; контракт RN = 100 акций. Дивиденд за 9 мес. ожидается в январе 2027 — впишите, когда объявят.
      "Enabled": false, // выключена 14.10.2026
      "StockSymbol": "ROSN@MISX",
      "StockLotSize": 1,
      "StockPriceStep": 0.05,
      "SharesPerContract": 100,
      "PointValue": 1,
      "FuturesPriceStep": 1,
      "Futures": [
        { "Symbol": "RNZ6@RTSX", "LastTradingDay": "2026-12-17", "InitialMargin": 8145 },
        { "Symbol": "RNH7@RTSX", "LastTradingDay": "2027-03-18", "InitialMargin": 9263 },
        { "Symbol": "RNM7@RTSX", "LastTradingDay": "2027-06-17", "InitialMargin": 11230 }
      ],
      "Dividends": [],
      "Strategy": { "MaxUnits": 3 }
    },
    {
      "Name": "ALRS",
      // АЛРОСА. Сверено с Финам 13.10.2026: лот ALRS = 10 акций; контракт AL = 100 акций.
      "Enabled": false, // выключена 13.10.2026
      "StockSymbol": "ALRS@MISX",
      "StockLotSize": 10,
      "StockPriceStep": 0.01,
      "SharesPerContract": 100,
      "PointValue": 1,
      "FuturesPriceStep": 1,
      "Futures": [
        { "Symbol": "ALZ6@RTSX", "LastTradingDay": "2026-12-17", "InitialMargin": 466 },
        { "Symbol": "ALH7@RTSX", "LastTradingDay": "2027-03-18", "InitialMargin": 535 }
      ],
      "Dividends": [],
      "Strategy": { "MaxUnits": 3 }
    }
  ],

  // Ваш тариф: доля от оборота по акциям и руб. за контракт по фьючерсам (брокер + биржа)
  "Commissions": {
    "StockRate": 0.0004,
    "FuturesPerContract": 2
  },

  // Общие параметры стратегии для всех пар
  "Strategy": {
    "ExitMode": "Both",
    "MinEntryAnnualYield": 0.12,
    "MinHoldAnnualYield": 0.06,
    "EarlyExitMinProfitPerUnit": 0,
    "MinRollAnnualYield": 0.16,
    "MinDaysToExpiryForEntry": 14,
    "RollWindowDays": 3,
    "UnitsPerEntry": 1,
    "MaxUnits": 3,
    "DividendTaxRate": 0.13
  },

  "Risk": {
    "VariationMarginReserve": 0.10,
    "MaxHedgeMismatchChecks": 3
  },

  "Execution": {
    "MaxSlippage": 0.002,
    "OrderTimeout": "00:00:05",
    "PollInterval": "00:00:00.500",
    "MaxAttemptsPerLeg": 3
  },

  "Paper": {
    // Simulated — синтетические цены; Finam — живые котировки Финам (нужен секрет, заявки остаются бумажными)
    "PriceSource": "Finam",
    "InitialCash": 50000,
    // Стартовые цены акций синтетического рынка по имени пары; для остальных — StartStockPrice
    "StartStockPrice": 300,
    "StartPrices": { "SBER": 300, "GAZP": 105, "LKOH": 6065, "GMKN": 119, "VTBR": 56.3, "ROSN": 378, "ALRS": 20.6 },
    "AnnualCarry": 0.20,
    "CarryNoisePerTick": 0.01,
    "CarryReversionPerTick": 0.05,
    "StockVolatilityPerTick": 0.0005,
    "Seed": null
  },

  // Секрет и номер счёта НЕ пишите сюда (файл в репозитории), а сохраните в user-secrets (в папке src/CashCarry.Host):
  //   dotnet user-secrets set "Finam:Secret" "<секрет>"
  //   dotnet user-secrets set "Finam:AccountId" "<номер счёта>"
  "Finam": {
    "Endpoint": "https://api.finam.ru:443",
    "AccountId": "",
    // false — сухой прогон: робот пишет в лог, что сделал бы, но заявок не выставляет
    "TradingEnabled": false,
    "RequestTimeout": "00:00:10",
    // true — через системный прокси/VPN (127.0.0.1:10809 на этой машине); false — напрямую
    "UseProxy": false
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cashcarry-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}

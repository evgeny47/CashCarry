{
  // Настройки тестера. Пары, стратегия, комиссии и риск берутся из настроек робота (src/CashCarry.Host/appsettings.json),
  // любой ключ можно переопределить из командной строки: --Strategy:MinEntryAnnualYield=0.10
  "Backtest": {
    "Timeframe": "M1",
    "InitialCash": 500000,
    // Спред, достраиваемый к цене закрытия свечи, в шагах цены
    "SpreadTicks": 1,
    // Прошлые дивиденды: последний день покупки с правом на дивиденд и сумма до налога.
    // В настройках робота только будущие; без отсечки в периоде прогона результат пары искажается.
    // GAZP за 2025 год дивидендов не платил (решение собрания 29.06.2026).
    "Dividends": {
      "SBER": [ { "LastBuyDate": "2026-07-17", "AmountPerShare": 37.64 } ],
      "VTBR": [ { "LastBuyDate": "2026-07-17", "AmountPerShare": 9.71 } ]
    },
    "HistoryDatabase": "data/history.db",
    "OutputDirectory": "data/backtest"
  }
}

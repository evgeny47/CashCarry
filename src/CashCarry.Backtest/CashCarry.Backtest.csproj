<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Те же user-secrets, что у робота: секрет Финам нужен для загрузки истории. -->
    <UserSecretsId>dotnet-CashCarry.Host-85befaad-4735-4873-93ac-95a66caa21cf</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Пары, стратегия, комиссии и риск — из настроек робота: тестер проверяет ровно то, чем торгует робот. -->
    <Content Include="..\CashCarry.Host\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="backtest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CashCarry.Engine\CashCarry.Engine.csproj" />
  </ItemGroup>
</Project>

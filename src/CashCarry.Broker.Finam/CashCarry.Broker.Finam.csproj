<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CashCarry.Core\CashCarry.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageReference Include="Grpc.Tools" Version="2.69.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Контракты Finam Trade API без изменений из github.com/FinamWeb/finam-trade-api (каталог proto/).
       Генерируем клиентов только для сервисов tradeapi; остальное — зависимости сообщений. -->
  <ItemGroup>
    <Protobuf Include="Protos/grpc/tradeapi/v1/**/*.proto" ProtoRoot="Protos" GrpcServices="Client" />
    <Protobuf Include="Protos/google/**/*.proto;Protos/grpc/gateway/**/*.proto" ProtoRoot="Protos" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CashCarry.Broker.Finam.Tests" />
  </ItemGroup>

</Project>
